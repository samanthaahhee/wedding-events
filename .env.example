# Supabase Postgres connection string — use the Transaction pooler URI (port 6543)
# from Project Settings → Database → Connection string in the Supabase dashboard.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Admin dashboard password
ADMIN_PASSWORD=change-me

# Random 32+ char string used to sign the admin session cookie
ADMIN_SESSION_SECRET=replace-with-a-32-plus-character-random-string

# Public canonical site URL (used for survey link generation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
